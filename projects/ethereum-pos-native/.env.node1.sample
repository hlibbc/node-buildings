## ============================================================
## ethereum-pos-native — node1 sample env
## 복사: cp .env.node1.sample .env
## 편집: NODE0_HOST, NODE1_HOST, FEE_RECIPIENT, STATIC_BOOTNODES, STATIC_ENRS 설정
## ============================================================

## Project
PROJECT_NAME=ethereum-pos-native
NODE_NAME=eth-pos-node1

## Network
CHAIN_ID=1111
NETWORK_ID=1111
NETWORK_NAME=eth-pos-devnet
TOTAL_VALIDATORS=64
SECONDS_PER_SLOT=12
SLOTS_PER_EPOCH=32

## Validator range — node0: 0~31, node1: 32~63 (중복 금지)
VALIDATOR_START_INDEX=32
VALIDATOR_COUNT=32

## Data & config paths (Linux native)
EXECUTION_ROOT=/var/lib/ethereum-pos-native/geth
BEACON_ROOT=/var/lib/ethereum-pos-native/prysm-beacon
VALIDATOR_ROOT=/var/lib/ethereum-pos-native/prysm-validator
CONFIG_ROOT=/etc/ethereum-pos-native
LOG_ROOT=/var/log/ethereum-pos-native

## Geth HTTP RPC (외부 접근 허용)
GETH_HTTP_ADDR=0.0.0.0
GETH_HTTP_PORT=8545

## Geth WebSocket (기본 비활성 — 필요 시 true로 변경 후 서비스 재설치)
GETH_WS_ENABLED=false
GETH_WS_ADDR=0.0.0.0
GETH_WS_PORT=8546

## Geth P2P
GETH_P2P_PORT=30303

## Geth Engine API (authrpc) — 외부 공개 금지
GETH_AUTHRPC_ADDR=127.0.0.1
GETH_AUTHRPC_PORT=8551

## Prysm Beacon REST API
BEACON_REST_ADDR=0.0.0.0
BEACON_REST_PORT=3500

## Prysm Beacon gRPC (내부 전용 — validator 연결용)
BEACON_GRPC_PORT=4000

## Prysm Beacon P2P
BEACON_P2P_TCP_PORT=13000
BEACON_P2P_UDP_PORT=12000

## Fee recipient (devnet 기본값: zero address)
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

## Peer 설정 (첫 기동 후 상대 노드 정보 확인 후 입력)
NODE0_HOST=
NODE1_HOST=

## Geth static peers
STATIC_BOOTNODES=

## Prysm beacon static peers
STATIC_ENRS=

## Prysm beacon P2P 외부 광고 주소 (Prysm --p2p-host-ip / --p2p-host-dns)
## beacon ENR에 loopback(127.0.0.1) 또는 0.0.0.0이 광고되면 peer 연결이 실패합니다.
## NODE1_HOST와 동일 값 권장. 둘 중 하나만 설정 (IP 우선).
P2P_ADVERTISE_IP=
P2P_ADVERTISE_DNS=
