## ============================================================
## arbitrum-l2-docker — .env.sample
## Copy: cp .env.sample .env
##
## [!] SECURITY WARNING — DEVNET ONLY [!]
##
##   이 파일에는 공개된 Anvil well-known dev account 키가 포함되어 있습니다.
##   이 키들은 비밀이 아닙니다. 누구나 알고 있습니다.
##
##   반드시 아래 환경에서만 사용하세요:
##     * local Docker devnet (이 머신에서만 접근 가능한 경우)
##     * 내부망 전용 private devnet (RPC가 외부 노출되지 않은 경우)
##
##   절대 사용 금지:
##     * public testnet (Sepolia, Holesky 등)
##     * Ethereum mainnet (chainId 1)
##     * Arbitrum One (chainId 42161)
##     * Arbitrum Sepolia (chainId 421614)
##     * 그 외 모든 상용망 또는 자산이 있는 네트워크
##
##   artifact에는 private key가 절대 포함되어서는 안 됩니다.
##   scripts는 모든 artifact 생성 후 자동으로 secret field를 검사합니다.
##
##   서버실 devnet이라도 RPC 포트를 외부에 노출하지 마세요.
## ============================================================

## --- Devnet safety gate ---
## Well-known key 사용을 명시적으로 허용합니다 (devnet 전용).
## public chain에서는 check 단계에서 자동 차단됩니다.
DEVNET_ALLOW_WELL_KNOWN_KEYS=true

## --- Input artifact ---
## L1 devnet artifact. Copy from ethereum-pos-docker:
##   cp ../ethereum-pos-docker/artifacts/l1-chain-info.json ./config/l1-chain-info.json
L1_CHAIN_INFO_PATH=./config/l1-chain-info.json

## --- Optional L1 endpoint overrides ---
## Use when L1 and L2 run on different machines.
## If empty, values from l1-chain-info.json are used.
L1_RPC_URL=
L1_WS_URL=
L1_CHAIN_ID=

## --- L2 chain ---
L2_CHAIN_ID=1721702
L2_CHAIN_NAME=l2konet-dev
L2_NATIVE_TOKEN_SYMBOL=ETH
L2_NATIVE_TOKEN_DECIMALS=18
L2_CUSTOM_GAS_TOKEN=false

## --- L2 ports ---
L2_RPC_PORT=8547
L2_WS_PORT=8548
L2_FEED_PORT=9642

## --- Docker images / versions ---
NITRO_NODE_IMAGE=offchainlabs/nitro-node:v3.9.6-91bf578
NITRO_CONTRACTS_BRANCH=v3.1.0

## --- L1 → L2 depositor (required) ---
## Must match l1-chain-info.json prefundedAccounts role l2Depositor.
## Must also match ethereum-pos-docker .env: L2_DEPOSITOR_ADDRESS (anvil #0).
## L1 genesis prefund: 1,000,000,000 ETH.
## Private key stays in L2 project only — never in L1 artifacts.
## [DEVNET] anvil account #0
L2_DEPOSITOR_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
L2_DEPOSITOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

## --- L1 funding: depositor → deployer / batchPoster / validator ---
## These accounts send L1 txs, so they need L1 ETH before rollup deploy.
## Run: pnpm run fund:l1  (02-fund-l1-role-accounts.sh)
L1_DEPLOYER_FUND_ETH=1000
L1_BATCH_POSTER_FUND_ETH=1000
L1_VALIDATOR_FUND_ETH=1000

## --- L1 → L2 deposit amount ---
## Depositor sends this amount from L1 to L2 via Inbox.depositEth().
L1_TO_L2_DEPOSIT_ETH=500000000

## --- L2 role accounts (required) ---
## Deployer: deploys rollup/system contracts on L1.
## [DEVNET] anvil account #1
L2_DEPLOYER_ADDRESS=0x70997970c51812dc3a010c7d01b50e0d17dc79c8
L2_DEPLOYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945382e9dae61377c9d6aefaf11c8f8d7bd4ee

## Rollup owner: owns the rollup contract. Can upgrade.
## [DEVNET] anvil account #2
L2_ROLLUP_OWNER_ADDRESS=0x3c44cdddb6a900fa2b585dd299e03d12fa4293bc
L2_ROLLUP_OWNER_PRIVATE_KEY=0x5de4111afa1a4b4bc8b6fc3fbb795ccca43dbb99ca0e79e4877e8e19a643c8e

## Sequencer: signs L2 blocks (used in sequencer_config.json).
## [DEVNET] anvil account #3
L2_SEQUENCER_ADDRESS=0x90f79bf6eb2c4f870365e785982e1f101e93b906
L2_SEQUENCER_PRIVATE_KEY=0x7c852118294bb2ba8bbf7e7cc2f2fba4f7442617d9e4a7685e57e72c0c6cde2c

## Batch poster: submits L2 tx batches to L1 sequencerInbox.
## Required — batch poster signs L1 transactions even in simple mode.
## [DEVNET] anvil account #4
L2_BATCH_POSTER_ADDRESS=0x15d34aaf54267db7d7c367839aaf71a00a2c6a65
L2_BATCH_POSTER_PRIVATE_KEY=0x47e179ec197488961f6fb3fcb1d04bfb75de443a9a06b5bcb1ce7d089903973

## Validator / staker: posts assertions / RBlocks to L1 rollup contract.
## Required — staker.enable=true is fixed. L2 without staker is
## insufficient as L3 parent chain.
## [DEVNET] anvil account #5
L2_VALIDATOR_ADDRESS=0x9965507d1a55bcc2695c58ba16fb37d819b0a4dc
L2_VALIDATOR_PRIVATE_KEY=0x8b3a350cf5c34c9194ca3a545d8e2df3544d4f0ef51e0b5de6e787de1400840

## Optional test/user account (L2 only, no L1 requirement).
## [DEVNET] anvil account #6 — address only (no private key needed for funding)
L2_TEST_USER_ADDRESS=0x976ea74026e726554db657fa54763abd0c3a0aa9

## --- L2 funding: depositor → role accounts (L2 ETH) ---
## After deposit, L2 depositor distributes L2 ETH to role accounts.
L2_DEPLOYER_FUND_ETH=1000
L2_ROLLUP_OWNER_FUND_ETH=1000
L2_SEQUENCER_FUND_ETH=1000
L2_BATCH_POSTER_FUND_ETH=1000
L2_VALIDATOR_FUND_ETH=1000
L2_TEST_USER_FUND_ETH=100
