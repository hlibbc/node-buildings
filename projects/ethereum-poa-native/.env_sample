## Project Config
PROJECT_NAME=

### Directory Configuration
ROOT_DIR= # 비워두면 스크립트 파일 위치로 자동 fallback (일반적으로 비워두면 됨)
CONFIG_DIR= # config 디렉토리 — 스크립트 시작 시 자동 생성
BACKUP_DIR= # backup 디렉토리 — 스크립트 시작 시 자동 생성
EXECUTION_ROOT= # geth datadir 상위 디렉토리 — 스크립트 시작 시 자동 생성

PASSWORD_ROOT= # password.txt 경로 (CONFIG_DIR 하위 경로 권장, generate 시 $CONFIG_DIR/password.txt 에 저장됨)

### Node Configuration
CHAIN_ID=                    # genesis config.chainId 및 --networkid 기본값
NETWORK_ID=                  # --networkid (미설정 시 CHAIN_ID 값으로 fallback)
MINER_ADDRESS=               # signer 계정 주소 (consensus 전용)

### Peer Configuration
# STATIC_PEER_ENODE: 현재 구현이 생성하는 static-nodes.json 은 geth 1.13.15 에서 deprecated/ignored 됨
# 자동 peer 연결 실효 없음 — 운영 시 geth 콘솔에서 admin.addPeer() 수동 실행 필요
# 향후 config.toml P2P.StaticNodes 기반으로 전환 예정
STATIC_PEER_ENODE=

### Consensus Node HTTP 바인딩
CONSENSUS_HTTP_ADDR=127.0.0.1  # consensus HTTP/WS 바인딩 주소 (외부 공개 금지)
                               # 완전히 끄려면 이 값을 비워두고 run-consensus의 --http/--ws 플래그 제거

### RPC configuration
GETH_HTTP_PORT=     # [GETH] --http.port (default: 8545)
GETH_WS_PORT=       # [GETH] --ws.port (default: 8546)
GETH_PORT=          # [GETH] --port p2p (default: 30303)
GETH_AUTH_RPC_PORT= # geth 1.13.x 는 Clique PoA 에서도 authrpc 를 자동 시작함
                    # 포트 충돌 방지용 — 비워두면 8551 사용