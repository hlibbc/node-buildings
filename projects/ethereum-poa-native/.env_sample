## Project Config
PROJECT_NAME=

### Directory Configuration
ROOT_DIR= # Project 최상위 디렉토리 (필요시 정의, 정의하지 않을 경우, 스크립트파일과 같은위치로 세팅됨)
CONFIG_DIR= # container config 디렉토리
BACKUP_DIR= # container backup 디렉토리
EXECUTION_ROOT= # execution & consensus 디렉토리

PASSWORD_ROOT= # password.txt
GENESIS_ROOT= # genesis.json
JWTSECRET_ROOT= # jwtsecret
IMPORT_ROOT= # Import File Root from Backup

### Node Configuration
CHAIN_ID=                    # genesis config.chainId 및 --networkid 기본값
NETWORK_ID=                  # --networkid (미설정 시 CHAIN_ID 값으로 fallback)
MINER_ADDRESS=               # signer 계정 주소 (consensus 전용)

### Peer Configuration
STATIC_PEER_ENODE=           # 상대 노드 enode URL (--nodiscover 환경에서 peer 연결)
                             # 예: enode://pubkey64hex@ip:30303

### Consensus Node HTTP 바인딩
CONSENSUS_HTTP_ADDR=127.0.0.1  # consensus HTTP/WS 바인딩 주소 (외부 공개 금지)
                               # 완전히 끄려면 이 값을 비워두고 run-consensus의 --http/--ws 플래그 제거

### RPC configuration
GETH_HOST=          # [GETH] (default: 127.0.0.1)
GETH_HTTP_PORT=     # [GETH] --http.port (default: 8545)
GETH_WS_PORT=       # [GETH] --ws.port (default: 8546)
GETH_PORT=          # [GETH] --port (default: 30303)