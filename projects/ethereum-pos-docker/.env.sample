## =============================================================
## ethereum-pos-docker — .env sample
## 복사: cp .env.sample .env
## 이미지 버전은 latest/stable 금지 — 반드시 명시 버전 유지
## =============================================================

## --- Docker image versions (pin explicitly) ---
## 변경 전 반드시 upstream 호환성 확인
GETH_VERSION=v1.14.12
PRYSM_VERSION=v5.3.2

## --- Chain ---
CHAIN_ID=1111
NETWORK_ID=1111
NETWORK_NAME=eth-pos-devnet
TOTAL_VALIDATORS=64
SECONDS_PER_SLOT=12
SLOTS_PER_EPOCH=32

## --- Fee recipient ---
## validator block proposal 시 EL 수수료(priority fee)를 받을 Execution Layer 주소
## - validator BLS key와 무관한 별도의 EVM 주소
## - config/prefund.json의 l1-fee-recipient 주소 사용 권장
## - devnet 기본: zero address (수수료 burn)
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

## --- Host port mapping (충돌 시 변경) ---
## node0
NODE0_RPC_PORT=8545
NODE0_BEACON_PORT=3500
NODE0_GETH_P2P_PORT=30303
NODE0_BEACON_P2P_TCP=13000
NODE0_BEACON_P2P_UDP=12000
## node1 (node0와 다른 host port로 분리)
NODE1_RPC_PORT=8645
NODE1_BEACON_PORT=3600
NODE1_GETH_P2P_PORT=30304
NODE1_BEACON_P2P_TCP=13001
NODE1_BEACON_P2P_UDP=12001

## --- WebSocket RPC ---
## L2/Nitro parent chain 연결용. 사내 개발/PoC 환경이므로 기본 true.
## 외부 노출이 우려되는 환경에서는 false로 설정.
GETH_WS_ENABLED=true

## node0 / node1 WS host port
NODE0_WS_PORT=8546
NODE1_WS_PORT=8646

## --- L2/L3 parent-chain bootstrap depositor ---
## This public address is funded in the L1 genesis allocation.
## The L2 deployment project uses this account to deposit ETH from L1 to L2.
## The same pattern can be reused for L2 -> L3 bootstrap deposits.
## Do NOT put private keys here.
## Private keys must be managed by the L2/L3 project .env or secrets file.

L2_DEPOSITOR_ADDRESS=
L2_DEPOSITOR_PREFUND_BALANCE_ETH=1000000000

## --- Genesis time (pnpm run generate 실행 시 자동 설정 — 직접 수정 불필요) ---
GENESIS_TIME=

## --- Peer 연결 (첫 기동 후 scripts/06-peer-connect.sh 실행 후 채워짐) ---
## Geth enode: enode://<pubkey>@<ip>:<port>
GETH_NODE0_ENODE=
GETH_NODE1_ENODE=
## Prysm beacon ENR (enr:-... 형식)
BEACON_NODE0_ENR=
BEACON_NODE1_ENR=
